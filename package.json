    "@arcblock/jwt": "^1.27.3",
    "@arcblock/ux": "^3.2.0",
    "@arcblock/vc": "^1.27.3",
    "@blocklet/logger": "^1.17.0",
    "@blocklet/meta": "^1.17.0",
    "@blocklet/sdk": "^1.17.0",
    "@mui/icons-material": "^7.3.4",
    "@mui/lab": "^7.0.1-beta.18",
    "@mui/material": "^7.3.4",
    "@nedb/core": "^2.1.5",
    "@ocap/client": "^1.27.3",
    "@ocap/contract": "^1.27.3",
    "@ocap/mcrypto": "^1.27.3",
    "@ocap/util": "^1.27.3",
    "@ocap/wallet": "^1.27.3",
    "axios": "^1.9.0",
    "body-parser": "^1.20.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv-flow": "^4.1.0",
    "express": "^4.21.2",
    "flat": "^5.0.2",
    "fs-extra": "^10.1.0",
    "lodash": "^4.17.21",
    "notistack": "^3.0.2",
    "number-precision": "^1.6.0",
